    affiliation: University of Bristol
license: MIT
repository-code: "https://github.com/bristolcrypto/controlbits"
keywords:
  - computer aided cryptography
  - formal methods
  - efficient software implementation
  - permutation networks
  - Beneš networks
  - Classic McEliece
  - Lean
  - Mathlib
